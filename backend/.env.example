PROJECT_NAME="Agentic AI Citizen Assistant"
API_V1_STR="/api/v1"

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
# For MySQL:
# DB_TYPE=mysql
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=citizen_assistant_db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Cellular SMS Gateway (Fast2SMS for India or Twilio globally)
# Fast2SMS gives free daily testing credits for Indian numbers (+91):
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Or Twilio (Optional):
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
